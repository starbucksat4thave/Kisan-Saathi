{
  "entities": {
    "FarmerProfile": {
      "title": "FarmerProfile",
      "description": "Profile data for smallholder barani farmer",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "language": { "type": "string" },
        "village": { "type": "string" },
        "tehsil": { "type": "string" },
        "level": { "type": "string" },
        "barkat_total_maund": { "type": "number" },
        "leaderboard_opt_in": { "type": "boolean" },
        "nickname": { "type": "string" },
        "points": { "type": "number" },
        "streak_weeks": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "name", "language", "village", "tehsil", "createdAt"]
    },
    "Field": {
      "title": "Field",
      "description": "Farmer agricultural plot with area and soil metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "area_acre": { "type": "number" },
        "centroid_lat": { "type": "number" },
        "centroid_lon": { "type": "number" },
        "water_access": { "type": "string" },
        "soil_texture": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "name", "area_acre", "centroid_lat", "centroid_lon", "createdAt"]
    },
    "Season": {
      "title": "Season",
      "description": "Crop cycle data tracking wheat development and yield",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "field_id": { "type": "string" },
        "crop": { "type": "string" },
        "variety": { "type": "string" },
        "season": { "type": "string" },
        "sowing_date": { "type": "string" },
        "harvest_date": { "type": "string" },
        "yield_maund": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "field_id", "crop", "season", "status", "createdAt"]
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "Farmer crop operation log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "season_id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "detail": { "type": "string" },
        "source": { "type": "string" },
        "matched_advisory_id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "season_id", "date", "type", "createdAt"]
    },
    "BarkatEvent": {
      "title": "BarkatEvent",
      "description": "Reward event recording estimated maunds of food saved",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "advisory_id": { "type": "string" },
        "maund_estimate": { "type": "number" },
        "loss_factor_id": { "type": "string" },
        "basis": { "type": "string" },
        "placeholder": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "advisory_id", "maund_estimate", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public community ranking entry for friendly village competition",
      "type": "object",
      "properties": {
        "farmerId": { "type": "string" },
        "nickname": { "type": "string" },
        "village": { "type": "string" },
        "score": { "type": "number" },
        "streak_weeks": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp submitted via FieldValue.serverTimestamp()" }
      },
      "required": ["farmerId", "nickname", "village", "score", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/FarmerProfile" },
      "description": "Farmer profile information scoped to authenticated user"
    },
    "/users/{userId}/fields/{fieldId}": {
      "schema": { "$ref": "#/entities/Field" },
      "description": "Agricultural land plots owned by the farmer"
    },
    "/users/{userId}/seasons/{seasonId}": {
      "schema": { "$ref": "#/entities/Season" },
      "description": "Crop seasons recorded for this farmer"
    },
    "/users/{userId}/diary/{entryId}": {
      "schema": { "$ref": "#/entities/DiaryEntry" },
      "description": "Agronomic action logs recorded by farmer"
    },
    "/users/{userId}/barkat_events/{eventId}": {
      "schema": { "$ref": "#/entities/BarkatEvent" },
      "description": "Barkat food conservation milestones"
    },
    "/leaderboard/{farmerId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Village leaderboard aggregated scores"
    }
  }
}
