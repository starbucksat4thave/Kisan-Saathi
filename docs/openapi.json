  "components": {
    "schemas": {
      "AdvisoryCard": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "node_key": {
            "type": "string",
            "title": "Node Key"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "act",
              "alert"
            ],
            "title": "Severity"
          },
          "title_ur": {
            "type": "string",
            "title": "Title Ur"
          },
          "body_ur": {
            "type": "string",
            "title": "Body Ur"
          },
          "body_en": {
            "type": "string",
            "title": "Body En"
          },
          "audio": {
            "type": "string",
            "title": "Audio"
          },
          "act_by": {
            "type": "string",
            "format": "date",
            "title": "Act By"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "memory_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemoryRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "barkat_if_done": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BarkatIfDone"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "key",
          "node_key",
          "severity",
          "title_ur",
          "body_ur",
          "body_en",
          "audio",
          "act_by",
          "sources",
          "confidence",
          "created_at"
        ],
        "title": "AdvisoryCard"
      },
      "Badge": {
        "properties": {
          "badge_key": {
            "type": "string",
            "title": "Badge Key"
          },
          "earned_at": {
            "type": "string",
            "format": "date-time",
            "title": "Earned At"
          }
        },
        "type": "object",
        "required": [
          "badge_key",
          "earned_at"
        ],
        "title": "Badge"
      },
      "BarkatIfDone": {
        "properties": {
          "maund_estimate": {
            "type": "number",
            "title": "Maund Estimate"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          },
          "placeholder": {
            "type": "boolean",
            "title": "Placeholder",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "maund_estimate",
          "basis"
        ],
        "title": "BarkatIfDone"
      },
      "DiaryEntry": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "season_id": {
            "type": "string",
            "format": "uuid",
            "title": "Season Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "type": {
            "type": "string",
            "enum": [
              "sowing",
              "fertilizer",
              "spray",
              "irrigation",
              "weeding",
              "harvest",
              "sale",
              "problem",
              "note"
            ],
            "title": "Type"
          },
          "detail": {
            "type": "object",
            "title": "Detail"
          },
          "source": {
            "type": "string",
            "enum": [
              "voice",
              "tap",
              "satellite_confirmed"
            ],
            "title": "Source"
          },
          "audio_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Note"
          },
          "matched_advisory_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Advisory Id"
          }
        },
        "type": "object",
        "required": [
          "season_id",
          "date",
          "type",
          "source"
        ],
        "title": "DiaryEntry"
      },
      "Farmer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "ur"
          },
          "village": {
            "type": "string",
            "title": "Village"
          },
          "tehsil": {
            "type": "string",
            "title": "Tehsil"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "barkat_total_maund": {
            "type": "number",
            "title": "Barkat Total Maund",
            "default": 0.0
          },
          "leaderboard_opt_in": {
            "type": "boolean",
            "title": "Leaderboard Opt In",
